{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      // Local plugin directory (resolved relative to this config file).
      "package": "../tools/swarm-runtime",
      "options": {
        // Watchdog timing
        "stallTimeoutMs": 180000,
        "monitorIntervalMs": 30000,

        // Coordinator delegates instead of editing files
        "allowCoordinatorEdits": false,
        "workerShellPolicy": "ask",
        "verifierShellPolicy": "ask",

        // Realtime Swarm Board Web UI on 127.0.0.1 (port 0 = ephemeral)
        "boardServer": true,
        "boardPort": 0,

        // Durable $60+ / ZDR assignments (shared Go pool friendly).
        // Coordinator inherits the session model; set it explicitly if you want to change it.
        "roleModels": {
          "coordinator": "opencode-go/deepseek-v4.1-flash#max",
          "worker":   "opencode-go/deepseek-v4.1-flash#high",
          "verifier": "opencode-go/glm-5.3-flash#high",
          "monitor":  "opencode-go/mimo-v2.6-flash",
          "narrator": "opencode-go/mimo-v2.6-flash"
        }

        // Optional manual model defaults per role (never auto-picked):
        // "roleModels": {
        //   "worker": "opencode-go/glm-4.6#high",
        //   "verifier": "opencode-go/glm-4.6#medium"
        // }
      }
    }
  ]
}
