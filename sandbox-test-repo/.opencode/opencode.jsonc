{
  "plugins": [
    {
      "package": "../tools/swarm-runtime",
      "options": {
        "stallTimeoutMs": 180000,
        "monitorIntervalMs": 30000,
        "allowCoordinatorEdits": false,
        "workerShellPolicy": "ask",
        "verifierShellPolicy": "ask",
        "boardServer": true,
        // Optional manual model+variant defaults per role (never auto-picked unless set):
        // "roleModels": {
        //   "worker": "anthropic/claude-sonnet-4-6#high",
        //   "verifier": "openai/gpt-5.4#medium"
        // },
        "debugHooks": true,
        "debugEvents": true
      }
    }
  ]
}
